{
  "name": "doti",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.cjs",
    "start": "next start",
    "electron": "electron .",
    "desktop:stage": "node scripts/prepare-electron-app.cjs",
    "desktop:dir": "node scripts/desktop-build.cjs --dir",
    "desktop:build": "node scripts/desktop-build.cjs --win",
    "lint": "eslint src public next.config.ts eslint.config.mjs tailwind.config.ts --cache --cache-location .cache/eslint",
    "typecheck": "tsc --noEmit",
    "test:desktop": "node --test tests/desktop-auth.test.mjs tests/runtime-paths.test.mjs tests/electron-runtime.test.mjs tests/media-session.test.mjs tests/mineru-client.test.mjs tests/translation-runtime.test.mjs tests/product-shell.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@bytemd/plugin-breaks": "^1.22.0",
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight": "^1.22.0",
    "@bytemd/plugin-math": "^1.22.0",
    "@bytemd/react": "^1.22.0",
    "@chenglou/pretext": "^0.0.5",
    "@google/genai": "^1.34.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "axios": "^1.13.2",
    "bytemd": "^1.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "dexie": "^4.4.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.562.0",
    "mime": "^4.1.0",
    "next": "16.1.0",
    "openai": "^6.15.0",
    "pdfjs-dist": "^5.4.449",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "cn.doti.pdf",
    "productName": "Doti",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next-rel/standalone",
        "to": ".next/standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "terms",
        "to": "terms",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "win": {
      "target": "nsis",
      "signtoolOptions": {
        "sign": "./scripts/no-op-sign.cjs"
      }
    },
    "directories": {
      "app": ".desktop-app",
      "output": "dist-electron"
    }
  }
}
